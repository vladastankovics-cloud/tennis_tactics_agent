# Tennis Tactics Agent - Environment Variables
# Copy this to .env and fill in your values

# =============================================================================
# TELEGRAM CODING AGENT
# =============================================================================

# Your Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (get from @userinfobot)
TELEGRAM_USER_ID=123456789

# =============================================================================
# AI API KEYS
# =============================================================================

# Google Gemini API Key (get from aistudio.google.com)
GEMINI_API_KEY=AIza...

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================

# Path to your project (defaults to current directory)
PROJECT_PATH=C:\Users\Vlada\projects\tennis_tactics_agent
